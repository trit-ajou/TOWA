# Cloud is the only supported deployment mode in the current build.
# Standalone (LocalFileAdapter) is reserved for the Electron-wrapped build with a real
# local file manager backing it; entering 'standalone' here will throw at startup.
# See issue #37.
VITE_DEPLOYMENT_MODE=cloud

VITE_SERVICE_ENGINE_URL=http://localhost:8000
VITE_MODEL_ENGINE_URL=http://localhost:8100

# Master switch for backend transport.
#   real     = HTTP calls to VITE_SERVICE_ENGINE_URL / VITE_MODEL_ENGINE_URL (production default)
#   emulated = in-memory mock (no engines needed; for isolated UI dev)
# Bulk toggle across all env files: ../../scripts/set-backend-mode.sh real|emulated
VITE_UI_BACKEND_MODE=real

# Per-domain overrides — only effective when VITE_UI_BACKEND_MODE=emulated.
# With master=real, setting any of these to 'emulated' throws at startup.
# Use case: master=emulated for offline UI dev, but selectively point one domain at a
# live engine (e.g. AI at a local model_engine while auth/files stay mocked).
# VITE_UI_AUTH_BACKEND=real
# VITE_UI_AI_BACKEND=real
# VITE_UI_FILES_BACKEND=real
