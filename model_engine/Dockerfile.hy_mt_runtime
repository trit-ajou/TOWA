FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    TOWA_MODEL_CACHE_DIR=/cache/models \
    HOME=/cache/models \
    XDG_CACHE_HOME=/cache/models \
    HF_HOME=/cache/models/huggingface \
    TRANSFORMERS_CACHE=/cache/models/huggingface/transformers

WORKDIR /app

RUN mkdir -p \
    /workspace \
    /artifacts \
    /cache/models \
    /cache/models/huggingface \
    /cache/models/huggingface/transformers

COPY requirements-base.txt /app/model_engine/requirements-base.txt
COPY requirements-hy-mt.txt /app/model_engine/requirements-hy-mt.txt

RUN python3 -m pip install --no-cache-dir -r /app/model_engine/requirements-hy-mt.txt

COPY . /app/model_engine

CMD ["python3", "-m", "model_engine.ipc.worker_entrypoint", "--help"]
