FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    TOWA_MODEL_CACHE_DIR=/cache/models \
    HOME=/cache/models \
    XDG_CACHE_HOME=/cache/models \
    TORCH_HOME=/cache/models/torch \
    HF_HOME=/cache/models/huggingface \
    TRANSFORMERS_CACHE=/cache/models/huggingface/transformers

WORKDIR /app

RUN mkdir -p \
    /workspace \
    /artifacts \
    /cache \
    /cache/models \
    /cache/models/torch \
    /cache/models/huggingface \
    /cache/models/huggingface/transformers

# Keep system packages here so the base Dockerfile remains lean for tests and contracts.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        patchelf \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-base.txt /app/model_engine/requirements-base.txt
COPY requirements-craft.txt /app/model_engine/requirements-craft.txt

# CRAFT currently pulls an older dependency stack that is not compatible with Python 3.11.
# Keep the inference image on Python 3.10 until the detector package is replaced or upgraded.
# This image is the local inference runtime for built-in text detection, OCR, and later workers.
RUN python3 -m pip install --no-cache-dir -r /app/model_engine/requirements-craft.txt
RUN torch_cpu_so=/usr/local/lib/python3.10/site-packages/torch/lib/libtorch_cpu.so \
    && patchelf --print-execstack "$torch_cpu_so" \
    && patchelf --clear-execstack "$torch_cpu_so" \
    && patchelf --print-execstack "$torch_cpu_so" | grep -qx "execstack: -" \
    && python3 -c "import torch; print(torch.__version__)" \
    && python3 -c "from craft_text_detector import Craft; print('craft import ok')"

COPY . /app/model_engine

CMD ["python3", "-m", "unittest", "discover", "-s", "/app/model_engine/tests", "-v"]
