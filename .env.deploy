# Tracked deploy defaults. deploy.sh copies this to .env on a fresh server.
# Local devs: this file is NOT a substitute for your own .env / .env.local.
#
# Edit production-only values here (CORS allow-list, public hostnames, master switch).
# Real secrets (API keys, DB password rotations) belong out-of-band, not in this file.

POSTGRES_DB=towa
POSTGRES_USER=towa
POSTGRES_PASSWORD=towa
POSTGRES_PORT=5432

SERVICE_ENGINE_PORT=8000
MODEL_ENGINE_PORT=8100
UI_ENGINE_PORT=5173

VITE_DEPLOYMENT_MODE=cloud
VITE_PUBLIC_HOST=towa.live
VITE_SERVICE_ENGINE_URL=https://api.towa.live
VITE_MODEL_ENGINE_URL=https://model.towa.live

# Production must hit real engines. Master=real also rejects any leftover per-domain
# 'emulated' override at startup — see ui_engine/towa-app/src/backend/index.ts.
VITE_UI_BACKEND_MODE=real

TOWA_SERVICE_ENGINE_URL=http://service-engine:8000
TOWA_SERVICE_ENGINE_TIMEOUT_SECONDS=10
SERVICE_ENGINE_CORS_ALLOW_ORIGINS=https://towa.live,http://localhost:5173
MODEL_ENGINE_CORS_ALLOW_ORIGINS=https://towa.live,http://localhost:5173
